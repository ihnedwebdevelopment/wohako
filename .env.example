# Zkopírujte jako .env.local a doplňte hodnoty. Na Vercelu je nastavte v Settings → Environment Variables.

# MongoDB Atlas — připojovací řetězec z Atlas → Connect → Drivers
MONGODB_URI=""
# Název databáze (výchozí: wohako)
MONGODB_DB="wohako"

# Heslo do administrace /administrator
ADMIN_PASSWORD=""
# Náhodný dlouhý řetězec pro podepisování přihlášení (volitelné)
ADMIN_SESSION_SECRET=""

# Kontaktní formulář (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="WOHAKO rekonstrukce <web@wohako.cz>"
