{
	"version": 3,
	"routes": [
		{
			"src": ".*",
			"continue": true,
			"transforms": [
				{
					"type": "request.query",
					"op": "delete",
					"target": {
						"key": "__pathname"
					}
				}
			]
		},
		{
			"src": "/3d",
			"dest": "/3d/"
		},
		{
			"src": "/3d/",
			"status": 308,
			"headers": {
				"Location": "/3d"
			}
		},
		{
			"src": "/galerie",
			"dest": "/galerie/"
		},
		{
			"src": "/galerie/",
			"status": 308,
			"headers": {
				"Location": "/galerie"
			}
		},
		{
			"src": "/kontakt",
			"dest": "/kontakt/"
		},
		{
			"src": "/kontakt/",
			"status": 308,
			"headers": {
				"Location": "/kontakt"
			}
		},
		{
			"src": "/pristup",
			"dest": "/pristup/"
		},
		{
			"src": "/pristup/",
			"status": 308,
			"headers": {
				"Location": "/pristup"
			}
		},
		{
			"src": "/realizace",
			"dest": "/realizace/"
		},
		{
			"src": "/realizace/",
			"status": 308,
			"headers": {
				"Location": "/realizace"
			}
		},
		{
			"src": "/sluzby",
			"dest": "/sluzby/"
		},
		{
			"src": "/sluzby/",
			"status": 308,
			"headers": {
				"Location": "/sluzby"
			}
		},
		{
			"src": "/realizace/compact",
			"dest": "/realizace/compact/"
		},
		{
			"src": "/realizace/compact/",
			"status": 308,
			"headers": {
				"Location": "/realizace/compact"
			}
		},
		{
			"src": "/realizace/walkin",
			"dest": "/realizace/walkin/"
		},
		{
			"src": "/realizace/walkin/",
			"status": 308,
			"headers": {
				"Location": "/realizace/walkin"
			}
		},
		{
			"src": "/realizace/kitchen",
			"dest": "/realizace/kitchen/"
		},
		{
			"src": "/realizace/kitchen/",
			"status": 308,
			"headers": {
				"Location": "/realizace/kitchen"
			}
		},
		{
			"src": "/realizace/bath",
			"dest": "/realizace/bath/"
		},
		{
			"src": "/realizace/bath/",
			"status": 308,
			"headers": {
				"Location": "/realizace/bath"
			}
		},
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/_app/immutable/.+",
			"status": 404,
			"headers": {
				"cache-control": "no-store"
			},
			"continue": false
		},
		{
			"src": "^/api/kontakt/?(?:/__data.json)?$",
			"dest": "/api/kontakt"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {
		"index.html": {
			"path": ""
		},
		"3d.html": {
			"path": "3d"
		},
		"galerie.html": {
			"path": "galerie"
		},
		"kontakt.html": {
			"path": "kontakt"
		},
		"pristup.html": {
			"path": "pristup"
		},
		"realizace.html": {
			"path": "realizace"
		},
		"sluzby.html": {
			"path": "sluzby"
		},
		"realizace/compact.html": {
			"path": "realizace/compact"
		},
		"realizace/walkin.html": {
			"path": "realizace/walkin"
		},
		"realizace/kitchen.html": {
			"path": "realizace/kitchen"
		},
		"realizace/bath.html": {
			"path": "realizace/bath"
		}
	}
}